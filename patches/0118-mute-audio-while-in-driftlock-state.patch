From 6b2c16b234560000c60027e89b33291fd29ccad9 Mon Sep 17 00:00:00 2001
From: Martin Kibera <martin.kibera.n@gmail.com>
Date: Wed, 29 Jul 2026 12:34:54 +0300
Subject: [PATCH] mute audio while in driftlock state

---
 html/static/js/player.js | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/html/static/js/player.js b/html/static/js/player.js
index d65ae9e..51503b7 100644
--- a/html/static/js/player.js
+++ b/html/static/js/player.js
@@ -801,6 +801,7 @@ if (isChrome) {
                 savedPlaybackRate = videoElement.playbackRate;
                 videoElement.playbackRate = 0.0625;
                 audioElement.playbackRate = 0.0625;
+                audioElement.muted = true
                 videoElement.pause();
                 startResumeMonitor();
             }
@@ -826,6 +827,7 @@ if (isChrome) {
 
                 videoElement.playbackRate = savedPlaybackRate;
                 audioElement.playbackRate = savedPlaybackRate;
+                audioElement.muted = false
                 videoElement.play().catch(() => {});
                 audioElement.play().catch(() => {});
 
-- 
2.55.0

