From 9f58f2bfe80c6b3b0209145c1d5ef14201eef49f Mon Sep 17 00:00:00 2001
From: Martin Kibera <martin.kibera.n@gmail.com>
Date: Wed, 29 Jul 2026 12:51:25 +0300
Subject: [PATCH] mute audio that has loaded ahead of video before snapping

---
 html/static/js/player.js | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/html/static/js/player.js b/html/static/js/player.js
index 51503b7..f925a06 100644
--- a/html/static/js/player.js
+++ b/html/static/js/player.js
@@ -478,7 +478,10 @@ function startSyncCheck() {
             const minBufferLead = 2.0;
 
             if (bufferLead >= minBufferLead) {
+                const wasMuted = audioElement.muted;
+                audioElement.muted = true;
                 audioElement.currentTime = videoTime;
+                requestAnimationFrame(() => { audioElement.muted = wasMuted; });
             }
         }
     }, syncInterval);
-- 
